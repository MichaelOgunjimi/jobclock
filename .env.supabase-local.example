# Local Supabase (Docker). Copy to .env.local to develop without touching any
# hosted project. Start the stack with `supabase start`, then apply the schema:
#   DATABASE_URL=<below> npm run db:migrate
#   psql <below> -f supabase/sql/platform-setup.sql
# Get the two keys from the running stack: supabase status -o env   (ANON_KEY, SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Generate your own: openssl rand -hex 32 (never reuse another environment's)
ENCRYPTION_SECRET=
CRON_SECRET=

# Port comes from .worktree.env (make new-worktree); keep in sync with it
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_DEV_ORIGIN=http://localhost:3000

# Required: with APP_ENV=local, rate limiting is skipped when Upstash is not
# configured (src/lib/rate-limit.ts). Any other APP_ENV without Upstash throws.
APP_ENV=local

# Billing, QStash and Telegram stay unset locally (jobs run inline).
# Only set these to a NON-production Upstash database, never production's:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
