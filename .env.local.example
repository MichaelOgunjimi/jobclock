# Core application and Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_DIRECT_URL=
ENCRYPTION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_DEV_ORIGIN=http://localhost:3000

# Optional AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Stripe Billing (keep disabled until sandbox configuration is complete)
BILLING_ENABLED=false
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# Optional job sources
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
CAREERJET_API_KEY=

# Optional Telegram Bot API intake
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional rate limiting and background work
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=

# Outbound email (src/lib/email/send.ts). With RESEND_API_KEY set, mail goes through Resend;
# otherwise it falls back to Beaco below (local development); with neither set, email is skipped.
RESEND_API_KEY=
# Optional. Defaults to "JobClock <hello@jobclock.dev>"; the domain must be verified in Resend.
EMAIL_FROM=

# Optional. Job alert digests stay off until this is "true": there is no per-user alert setting yet.
JOB_ALERT_EMAILS_ENABLED=

# Optional event delivery (Beaco: local development only). Emails go as finished HTML via Beaco's `inline` field.
BEACO_API_URL=
BEACO_API_KEY=
